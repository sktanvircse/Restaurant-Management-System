# =============================================================================
# RESTAURANT MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://root:yourpassword@localhost:3306/restaurant_db"

# -----------------------------------------------------------------------------
# JWT SECRETS (use strong random strings in production)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-this-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# -----------------------------------------------------------------------------
# EMAIL (Nodemailer - Gmail SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Spice Garden <noreply@spicegarden.com>"

# -----------------------------------------------------------------------------
# SSLCommerz Payment Gateway (sandbox)
# https://developer.sslcommerz.com/
# -----------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:3002/checkout/success
SSLCOMMERZ_FAIL_URL=http://localhost:3002/checkout/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3002/checkout/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn

# -----------------------------------------------------------------------------
# EXPO PUSH NOTIFICATIONS
# -----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=your_expo_access_token

# -----------------------------------------------------------------------------
# FRONTEND URLS (for CORS + email links)
# -----------------------------------------------------------------------------
ADMIN_URL=http://localhost:3000
CUSTOMER_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10        # stricter for auth endpoints

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug   # error | warn | info | debug
